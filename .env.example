# --- Harita (tarayıcıda görünür; Google Cloud'da "HTTP referrer" ile alan adına kısıtla, Maps JavaScript API + Places API (New): canlı puan/saat için) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Üretimde kendi Map ID'n (Google Cloud > Map Management). Boşsa geliştirme için DEMO_MAP_ID kullanılır.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# --- Veri çekme (SUNUCU tarafı; asla NEXT_PUBLIC_ yapma. Maps JS anahtarından AYRI bir anahtar kullan, IP ile kısıtla, yalnızca Places API) ---
GOOGLE_MAPS_API_KEY=
TRIPADVISOR_API_KEY=

# --- Ortak oda veritabanı yolu (varsayılan data/selam.db) ---
# SELAM_DB=

# --- Mobil paket (derleme zamanında gömülür; bkz. docs/MOBILE.md) ---
# Barındırılan sunucunun adresi (ortak oda API'si). Boşsa mobilde ortak oda çalışmaz.
NEXT_PUBLIC_API_BASE=
# Paylaşılan bağlantıların kökü (gerçek web adresi). Boşsa mobilde bozuk bağlantı paylaşılır.
NEXT_PUBLIC_WEB_URL=
# Sunucu: mobil WebView kökenleri (varsayılan: capacitor://localhost,https://localhost,http://localhost)
# CORS_ORIGINS=
